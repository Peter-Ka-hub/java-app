  "components": {
    "parameters": {
      "UuidPathId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "example": "3fa85f64-5717-4562-b3fc-2c963f66afa6"
      },
      "PageParam": {
        "name": "page",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      },
      "SizeParam": {
        "name": "size",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid request data",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "InternalServerError": {
        "description": "Internal server error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "SchoolRequest": {
        "type": "object",
        "required": ["name", "address", "dateOfConstruction", "type"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "example": "Liceum Ogólnokształcące nr 1"
          },
          "address": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "example": "ul. Szkolna 5, 00-001 Warszawa"
          },
          "dateOfConstruction": {
            "type": "string",
            "format": "date",
            "example": "2000-09-01"
          },
          "type": {
            "$ref": "#/components/schemas/SchoolType"
          }
        }
      },
      "SchoolResponse": {
        "type": "object",
        "required": ["id", "name", "address", "dateOfConstruction", "type"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "3fa85f64-5717-4562-b3fc-2c963f66afa6"
          },
          "name": {
            "type": "string",
            "example": "Liceum Ogólnokształcące nr 1"
          },
          "address": {
            "type": "string",
            "example": "ul. Szkolna 5, 00-001 Warszawa"
          },
          "dateOfConstruction": {
            "type": "string",
            "format": "date",
            "example": "2000-09-01"
          },
          "type": {
            "$ref": "#/components/schemas/SchoolType"
          }
        }
      },
      "SchoolType": {
        "type": "string",
        "enum": ["PRIMARY", "SECONDARY", "TERTIARY"]
      },
      "SchoolPageResponse": {
        "type": "object",
        "required": ["items", "page", "size", "totalElements", "totalPages"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SchoolResponse"
            }
          },
          "page": {
            "type": "integer",
            "example": 0
          },
          "size": {
            "type": "integer",
            "example": 20
          },
          "totalElements": {
            "type": "integer",
            "format": "int64",
            "example": 120
          },
          "totalPages": {
            "type": "integer",
            "example": 6
          }
        }
      },
      "UserRequest": {
        "type": "object",
        "required": ["firstName", "lastName", "email", "role", "dateOfBirth"],
        "properties": {
          "firstName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "example": "Jan"
          },
          "lastName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "example": "Kowalski"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 50,
            "example": "example@gmail.com"
          },
          "role": {
            "$ref": "#/components/schemas/UserRole"
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date",
            "example": "2000-01-01"
          },
          "schoolId": {
            "type": "string",
            "format": "uuid",
            "example": "3fa85f64-5717-4562-b3fc-2c963f66afa6"
          }
        }
      },
      "UserResponse": {
        "type": "object",
        "required": ["id", "firstName", "lastName", "email", "role", "dateOfBirth"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "4fa85f64-5717-4562-b3fc-2c963f66afa6"
          },
          "firstName": {
            "type": "string",
            "example": "Jan"
          },
          "lastName": {
            "type": "string",
            "example": "Kowalski"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 50,
            "example": "example@gmail.com"
          },
          "role": {
            "$ref": "#/components/schemas/UserRole"
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date",
            "example": "2000-01-01"
          },
          "schoolId": {
            "type": "string",
            "format": "uuid",
            "example": "3fa85f64-5717-4562-b3fc-2c963f66afa6"
          }
        }
      },
      "UserRole": {
        "type": "string",
        "enum": ["STUDENT", "TEACHER", "ADMIN"]
      },
      "UserPageResponse": {
        "type": "object",
        "required": ["items", "page", "size", "totalElements", "totalPages"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserResponse"
            }
          },
          "page": {
            "type": "integer",
            "example": 0
          },
          "size": {
            "type": "integer",
            "example": 20
          },
          "totalElements": {
            "type": "integer",
            "format": "int64",
            "example": 50
          },
          "totalPages": {
            "type": "integer",
            "example": 3
          }
        }
      },
      "SubjectRequest": {
        "type": "object",
        "required": ["name", "teacherId"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "example": "math"
          },
          "teacherId": {
            "type": "string",
            "format": "uuid",
            "example": "3fa85f64-5717-4562-b3fc-2c963f66afa6"
          },
          "studentIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "SubjectResponse": {
        "type": "object",
        "required": ["id", "name", "teacherId", "studentIds"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "4fa85f64-5717-4562-b3fc-2c963f66afa6"
          },
          "name": {
            "type": "string",
            "example": "math"
          },
          "teacherId": {
            "type": "string",
            "format": "uuid",
            "example": "4fa85f64-5717-4562-b3fc-2c963f66afa6"
          },
          "studentIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "SubjectPageResponse": {
        "type": "object",
        "required": ["items", "page", "size", "totalElements", "totalPages"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SubjectResponse"
            }
          },
          "page": {
            "type": "integer",
            "example": 0
          },
          "size": {
