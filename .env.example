# Copy to .env, supply independent strong secrets, and keep .env out of Git.
DATABASE_NAME=school_diary
DATABASE_USERNAME=school_diary
DATABASE_PASSWORD=
# Enable only to create the initial administrator. Disable and remove bootstrap
# credentials after initialization; this does not reset an existing account.
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_EMAIL=admin@example.test
BOOTSTRAP_ADMIN_PASSWORD=

# Compose binds the app to loopback; set true with an HTTPS reverse proxy.
SESSION_COOKIE_SECURE=false
APP_PORT=8080
